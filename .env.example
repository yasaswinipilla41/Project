# ---------------------------------------------------------------- Prio
# Copy to .env and adjust. Never commit the real .env.

# Database ------------------------------------------------------------
POSTGRES_USER=prio
POSTGRES_PASSWORD=prio_dev_password
POSTGRES_DB=prio
DATABASE_URL=postgresql://prio:prio_dev_password@localhost:5432/prio?schema=public

# Redis (BullMQ) ------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BASE_URL=http://localhost:3000

# SMTP ----------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Prio <no-reply@prio.local>"
SMTP_SECURE=false

# Seeding -------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@symbiosystech.com
SEED_ADMIN_PASSWORD=Prio@12345
SEED_DEFAULT_PASSWORD=Prio@12345
