{
  "name": "prio",
  "version": "0.1.0",
  "private": true,
  "description": "Prio — Internal Project & Issue Management",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "worker": "tsx src/server/jobs/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "loadtest:seed": "tsx scripts/load-test-seed.ts",
    "loadtest:clean": "tsx scripts/load-test-seed.ts --cleanup",
    "brand:generate": "tsx scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.1",
    "bootstrap": "5.3.8",
    "bullmq": "6.1.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "6.0.0",
    "next": "16.3.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "write-excel-file": "^4.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
