// Prio - Internal Project & Issue Management
// Single Issue table: a Bug is Issue.type = BUG with bug-specific fields populated.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (Migrate) and is
// supplied to PrismaClient through the node-postgres driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN
  MEMBER
}

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
  FEATURE
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  /// Displayed as "Ready for QA" — handed over, not yet picked up.
  IN_REVIEW
  /// Being tested right now. Declared after IN_REVIEW because enum order is
  /// what `orderBy: { status }` sorts on.
  IN_QA
  DONE
  /// Finished work that has come back. Declared after DONE because enum order
  /// is what `orderBy: { status }` sorts on.
  REOPENED
  /// Displayed as "Rejected / Not an Issue" - a closing status like CANCELLED,
  /// for work that turned out not to be work.
  REJECTED
  CANCELLED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum Severity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

/// Outcome of the most recent QA pass over an issue.
enum TestResult {
  NOT_TESTED
  PASSED
  FAILED
  BLOCKED
}

enum NotificationType {
  ISSUE_ASSIGNED
  MENTIONED
  STATUS_CHANGED
  COMMENT_ADDED
  INVITED
  USER_JOINED
  TEST_RESULT
  PROJECT_ACCESS_REQUEST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Only VIEW exists today; the field is kept as an enum so a future write
/// permission does not require a schema migration on top of a data one.
enum SharePermission {
  VIEW
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where a sprint is in its life.
///
/// A sprint only moves forwards: planned while it is being filled, active
/// while it is being worked, completed once it has been closed out. There is
/// no "cancelled" and no way back — a completed sprint is a record of what
/// happened, and rewinding one would be rewriting that record.
enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// ------------------------------------------------- better-auth + people

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Prio fields
  role                      Role      @default(MEMBER)
  jobTitle                  String?
  isActive                  Boolean   @default(true)
  lastSeenAt                DateTime?
  emailNotificationsEnabled Boolean   @default(true)

  sessions           Session[]
  accounts           Account[]
  projectMemberships ProjectMember[]
  createdProjects    Project[]          @relation("ProjectCreatedBy")
  uploads            Attachment[]       @relation("AttachmentUploadedBy")
  createdIssueLinks  IssueLink[]        @relation("IssueLinkCreatedBy")
  assignedIssues     Issue[]            @relation("IssueAssignee")
  testedIssues       Issue[]            @relation("IssueTestedBy")
  reportedIssues     Issue[]            @relation("IssueReporter")
  comments           Comment[]
  commentReactions   CommentReaction[]
  mentions           CommentMention[]
  activityEntries    ActivityLogEntry[]
  notifications      Notification[]     @relation("NotificationRecipient")
  actorNotifications Notification[]     @relation("NotificationActor")
  teamMemberships        TeamMember[]
  accessRequestsMade     ProjectAccessRequest[] @relation("AccessRequester")
  accessRequestsFor      ProjectAccessRequest[] @relation("AccessSubject")
  accessRequestsDecided  ProjectAccessRequest[] @relation("AccessDecider")
  watching           IssueWatcher[]
  favoriteProjects   ProjectFavorite[]
  pinnedProjects     ProjectPin[]
  recentProjects     ProjectRecent[]
  sentInvitations    Invitation[]       @relation("InvitationInvitedBy")
  createdSheetShares IssueSheetShare[]  @relation("IssueSheetShareCreatedBy")
  sheetShareGrants   IssueSheetShareMember[] @relation("IssueSheetShareMemberUser")
  sheetSharesGranted IssueSheetShareMember[] @relation("IssueSheetShareMemberAddedBy")
  createdSprints     Sprint[]           @relation("SprintCreatedBy")

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  /// better-auth scopes accounts by issuer; local credentials use "credential".
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  name        String?
  role        Role             @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User             @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@map("invitation")
}

// -------------------------------------------------------------- projects

model Project {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?

  /// Monotonic counter backing immutable issue keys (ENG-1, ENG-2 ...). Never decremented.
  issueSequence Int      @default(0)
  isArchived    Boolean  @default(false)
  /// Every self-registered account is added to projects with this set, the
  /// moment their account is created — see `signUp` in src/server/signup.ts.
  /// Off for every project until an admin turns it on.
  isDefaultProject Boolean @default(false)
  createdById   String
  createdBy     User     @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members     ProjectMember[]
  issues      Issue[]
  labels      Label[]
  attachments Attachment[]
  favoritedBy ProjectFavorite[]
  pinnedBy    ProjectPin[]
  recentlyVisitedBy ProjectRecent[]
  accessRequests    ProjectAccessRequest[]
  notifications     Notification[]
  sprints           Sprint[]

  @@index([isArchived])
  @@map("project")
}

/// A named group of people — "Testing", and later "Development", "Design",
/// whatever the organisation needs. Deliberately generic: a team is a row, not
/// a code path, so adding one never means touching authorization again.
///
/// Kept entirely separate from `Role` and from `ProjectMember`. Role answers
/// "may this person administer Prio", project membership answers "may they see
/// this project's work", and a team answers "what do they do here". Conflating
/// any two of them would mean granting one to grant another.
model Team {
  id          String  @id @default(cuid())
  /// Stable identifier used in code, e.g. "testing". Never displayed.
  slug        String  @unique
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]

  @@map("team")
}

/// Explicit membership. Nobody is ever a team member implicitly — not by role,
/// not by project, not by having reported bugs. A new account joins no team
/// until somebody puts them in one.
model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

/// A user's Flow Board star. Kept separate from `ProjectMember` rather than a
/// boolean on it — an ADMIN can favorite (and access) a project they were
/// never added to as a member, so favoriting cannot depend on a membership
/// row existing.
model ProjectFavorite {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_favorite")
}

/// A user's sidebar pin — kept to the top of their project list. Same shape
/// as `ProjectFavorite` and deliberately a separate table rather than a second
/// boolean on it: pinning and favoriting are independent, separately toggled
/// states in the product, not two views of one fact.
model ProjectPin {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_pin")
}

/// When a user last opened a project — backs the sidebar's "Recents" section.
/// One row per (project, user), upserted on visit rather than an append-only
/// log: the sidebar only ever needs "when most recently", never a history.
model ProjectRecent {
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId, lastVisitedAt])
  @@map("project_recent")
}

model Label {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  issues IssueLabel[]

  @@unique([projectId, name])
  @@map("label")
}

// ---------------------------------------------------------------- issues

model Issue {
  /// Immutable, unique across the organization - e.g. "ENG-124".
  id          String      @id @default(cuid())
  key         String      @unique
  /// Per-project sequence number; combined with Project.key forms `key`.
  number      Int
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        IssueType   @default(TASK)
  title       String
  description String?
  status      IssueStatus @default(BACKLOG)
  priority    Priority    @default(MEDIUM)

  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId String
  reporter   User    @relation("IssueReporter", fields: [reporterId], references: [id])

  dueDate   DateTime?
  /// Fractional-friendly ordering within a board column / backlog.
  sortIndex Float     @default(0)

  parentId String?
  parent   Issue?  @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("IssueHierarchy")

  /// The sprint this issue is currently in, or null for the project backlog.
  /// Nullable and `SetNull` on delete: an issue outlives any sprint it was
  /// part of, and deleting a sprint must never take work with it.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  // --- bug-specific (nullable for TASK / STORY) ---
  severity         Severity?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  environment      String?
  browser          String?
  operatingSystem  String?
  versionBuild     String?
  affectedModule   String?

  // --- QA verdict (the latest one; the full history lives in activity) ---
  testResult TestResult @default(NOT_TESTED)
  testedById String?
  testedBy   User?      @relation("IssueTestedBy", fields: [testedById], references: [id], onDelete: SetNull)
  testedAt   DateTime?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  labels        IssueLabel[]
  comments      Comment[]
  activity      ActivityLogEntry[]
  notifications Notification[]
  watchers      IssueWatcher[]
  attachments   Attachment[]
  /// Relationships this issue declared, e.g. "ENG-1 blocks ENG-4".
  linksFrom     IssueLink[]        @relation("IssueLinkSource")
  /// Relationships pointing at this issue, written automatically as inverses.
  linksTo       IssueLink[]        @relation("IssueLinkTarget")
  /// How this issue ended in each sprint it was closed out of.
  sprintOutcomes SprintIssueOutcome[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, type])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([severity])
  @@index([dueDate])
  @@index([parentId])
  @@index([sprintId])
  @@index([updatedAt])
  @@index([testResult])
  @@index([projectId, status, sortIndex])
  @@map("issue")
}

model IssueLabel {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_label")
}

model IssueWatcher {
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
  @@index([userId])
  @@map("issue_watcher")
}

model Comment {
  id       String    @id @default(cuid())
  issueId  String
  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String
  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  mentions      CommentMention[]
  notifications Notification[]
  attachments   Attachment[]
  reactions     CommentReaction[]

  @@index([issueId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("comment")
}

/// One person's one reaction to one comment.
///
/// A "like" is not a separate concept here — it is this row carrying a thumbs
/// up. One model rather than two means the count, the toggle and the "did I
/// already react" check are written once, and the unique constraint below is
/// what stops the same person reacting the same way twice.
model CommentReaction {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The reaction as the emoji shown. A like is stored as the thumbs-up emoji.
  emoji String

  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("comment_reaction")
}

model CommentMention {
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mention")
}

/// How one issue relates to another. Every type has an inverse, which Prio
/// writes automatically so the relationship reads correctly from both ends.
enum IssueLinkType {
  BLOCKS
  IS_BLOCKED_BY
  RELATES_TO
  DUPLICATES
  IS_DUPLICATED_BY
}

/// A directed relationship between two issues, always stored as a matched pair
/// (A blocks B / B is blocked by A) so either issue can be read on its own.
model IssueLink {
  id       String        @id @default(cuid())
  sourceId String
  source   Issue         @relation("IssueLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Issue         @relation("IssueLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type     IssueLinkType

  createdById String
  createdBy   User     @relation("IssueLinkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  /// One relationship of a given kind between a given pair, and no more.
  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("issue_link")
}

/// An uploaded file. The bytes live in the storage provider, never in the
/// database: this row records where they went and what they claim to be.
///
/// Exactly one of `issueId` / `projectId` is set — an attachment belongs to
/// one issue or one project, never both, never neither. `commentId` further
/// narrows an issue attachment to one specific comment; it is never set
/// alongside `projectId`. The application enforces this (see
/// `POST /api/attachments`), matching how every other cross-cutting rule in
/// this schema is validated in code rather than a DB constraint.
model Attachment {
  id        String   @id @default(cuid())
  issueId   String?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set when the file was attached to a comment rather than to the issue.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  /// The name the uploader saw. Never used to build a path.
  filename   String
  /// Opaque key within the storage provider — the provider owns its layout.
  storageKey String @unique
  /// Verified server-side from the file's own bytes, not from the upload header.
  mimeType   String
  byteSize   Int
  /// Pixel dimensions for images, when they could be read.
  width      Int?
  height     Int?

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([projectId, createdAt])
  @@index([commentId])
  @@index([uploadedById])
  @@map("attachment")
}

/// Immutable audit trail. Rows are never updated or deleted.
model ActivityLogEntry {
  id       String  @id @default(cuid())
  issueId  String
  issue    Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId  String
  actor    User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /// e.g. "issue.created", "issue.updated", "comment.created"
  action   String
  /// Changed field name, e.g. "status", "priority", "severity"
  field    String?
  oldValue String?
  newValue String?

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("activity_log_entry")
}

/// The org-wide "Issues Sheet" share: one link, grantable to specific
/// members. Kept as a single row created on first use (§ Share Issue Sheet)
/// rather than one per filter combination — the shared view always re-runs
/// the live issue query, never a stored copy.
model IssueSheetShare {
  id          String   @id @default(cuid())
  /// Opaque, unguessable — the only thing the /shared/issues/[token] route
  /// trusts to locate a share; membership is still checked separately.
  token       String   @unique
  createdById String
  createdBy   User     @relation("IssueSheetShareCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members IssueSheetShareMember[]

  @@map("issue_sheet_share")
}

/// One person's grant of access to a shared Issues Sheet.
model IssueSheetShareMember {
  id         String          @id @default(cuid())
  shareId    String
  share      IssueSheetShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("IssueSheetShareMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  permission SharePermission @default(VIEW)
  addedById  String
  addedBy    User            @relation("IssueSheetShareMemberAddedBy", fields: [addedById], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([shareId, userId])
  @@index([userId])
  @@map("issue_sheet_share_member")
}

/// Somebody with access to a project asking an administrator to grant it to
/// somebody else. Prio's membership model is a single binary — you are on a
/// project or you are not — and only an administrator may change it, so a
/// member who wants to bring a colleague in has to ask. This is that ask,
/// kept as a row so it survives the asking and can be answered later.
model ProjectAccessRequest {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The member who asked.
  requesterId String
  requester   User   @relation("AccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// The person who would gain access if this is approved.
  subjectId String
  subject   User   @relation("AccessSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  status  AccessRequestStatus @default(PENDING)
  message String?

  decidedById String?
  decidedBy   User?     @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, status])
  @@index([subjectId])
  @@index([requesterId])
  @@map("project_access_request")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issueId   String?
  issue     Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Set for notifications about a project rather than an issue — an access
  /// request has no issue to hang off, and without this its notification
  /// would have nowhere to open.
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------- sprints

/// A fixed period during which one project's team works a chosen set of its
/// issues.
///
/// A sprint belongs to exactly one project, and so does every issue in it:
/// `Issue.sprintId` points here, and the server refuses an issue whose
/// `projectId` is not this project's. There is no cross-project sprint and no
/// way to make one.
///
/// A sprint holds no status of its own for the work inside it. Whether an
/// issue is finished is `Issue.status`, the same field the board, the list and
/// the detail page all read — so a sprint's progress moves the moment anybody
/// moves a card, and there is no second copy of the truth to fall out of step.
model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNED)

  /// When it was actually started and completed, as distinct from the dates
  /// it was planned for — a sprint is rarely started at midnight on its start
  /// date, and the difference is worth keeping.
  startedAt   DateTime?
  completedAt DateTime?

  createdById String
  createdBy   User     @relation("SprintCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The issues in it right now. Empty for a completed sprint whose work all
  /// moved on — which is why the outcome rows below exist.
  issues   Issue[]
  outcomes SprintIssueOutcome[]

  @@index([projectId, status])
  @@index([projectId, startDate])
  @@map("sprint")
}

/// What a sprint held when it was completed, and how each of those ended.
///
/// Written once, by `completeSprint`, for every issue in the sprint at that
/// moment. It exists because completing a sprint moves the unfinished work out
/// of it — to the backlog or to the next sprint — and without a record of its
/// own a completed sprint would quietly lose exactly the issues its report is
/// about. These rows are the sprint's permanent history: they are never
/// rewritten when the issue moves on afterwards, and never deleted while the
/// sprint exists.
model SprintIssueOutcome {
  id       String @id @default(cuid())
  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issueId  String
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  /// Whether the issue was finished by the time the sprint closed, decided by
  /// `Issue.status` at that moment against the same `CLOSED_STATUSES` the rest
  /// of Prio uses.
  completed Boolean

  createdAt DateTime @default(now())

  @@unique([sprintId, issueId])
  @@index([issueId])
  @@map("sprint_issue_outcome")
}
